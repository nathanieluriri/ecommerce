{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shop-email",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Outbound through Cloudflare. Without Email Service sending enabled this only reaches verified addresses; set RESEND_API_KEY to send anywhere.
  "send_email": [{ "name": "MAILER" }],
  // Sends queued newsletter broadcasts in small batches.
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "MONGODB_DB": "shop",
    "DEFAULT_FROM": "orders@example.com",
    "FORWARD_TO": "",
    "STOREFRONT_URL": "https://shop-storefront.uririnathaniel.workers.dev",
    "BROADCAST_BATCH": "40"
  }
  // Secrets: wrangler secret put MONGODB_URI, optional RESEND_API_KEY
}
