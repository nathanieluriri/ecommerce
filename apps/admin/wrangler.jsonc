{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shop-admin",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "services": [
    { "binding": "ORDERS", "service": "shop-orders" },
    { "binding": "EMAIL", "service": "shop-email" }
  ],
  // Same bucket as the storefront. Create once: npx wrangler r2 bucket create shop-media
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "shop-media" }],
  "vars": { "MONGODB_DB": "shop", "STOREFRONT_URL": "https://shop-storefront.uririnathaniel.workers.dev" }
  // Secrets: MONGODB_URI, AUTH_SECRET (any long random string)
}
