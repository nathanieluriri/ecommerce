{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shop-storefront",
  "main": "src/index.tsx",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Brand images and other static files in ./public, served before the worker runs.
  "assets": { "directory": "./public" },
  "services": [
    { "binding": "ORDERS", "service": "shop-orders" },
    { "binding": "EMAIL", "service": "shop-email" }
  ],
  // Product images uploaded from the admin. Create once: npx wrangler r2 bucket create shop-media
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "shop-media" }],
  // Every storefront domain points at this one worker. Add each as a custom domain, e.g.
  // "routes": [{ "pattern": "shop-a.com", "custom_domain": true }, { "pattern": "shop-b.com", "custom_domain": true }],
  "vars": { "MONGODB_DB": "shop", "DEFAULT_STORE": "" }
  // Secrets: MONGODB_URI, CUSTOMER_SECRET (any long random string, signs customer sign-in links and sessions)
}
